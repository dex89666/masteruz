# Hamkorbank — интернет-эквайринг, динамические QR (UzQR)
# Пока нет договора с банком — HAMKOR_MOCK=true (в банк ничего не отправляется)
HAMKOR_MOCK=true
HAMKOR_API_URL=
HAMKOR_API_KEY=
HAMKOR_MERCHANT_ID=
HAMKOR_TERMINAL_ID=
HAMKOR_QR_TTL_SECONDS=900
# Вебхук /api/v1/payments/hamkor-webhook: без секрета отвечает 503
HAMKOR_WEBHOOK_SECRET=
HAMKOR_WEBHOOK_IPS=
HAMKOR_SIGNATURE_HEADER=X-Signature

# ════════════════════════════════════════════════════════════════════
# MasterUz — Шаблон переменных окружения
# Скопируй этот файл в .env (cp .env.example .env) и заполни значения.
# ВСЕ переменные хранятся в ОДНОМ файле .env (корень репо).
# backend/.env и frontend/.env — это симлинки на ../.env.
# ════════════════════════════════════════════════════════════════════

# ──────── Среда выполнения ────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# ──────── База данных ────────
DATABASE_URL=postgresql://user:password@localhost:5432/masteruz
DB_PASSWORD=

# ──────── Redis ────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ──────── JWT (генерировать через openssl rand -hex 64) ────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ──────── Telegram Bot (получить у @BotFather) ────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=http://localhost:5173
ADMIN_TELEGRAM_CHAT_ID=

# ──────── Yandex Maps ────────
YANDEX_MAPS_API_KEY=

# ──────── Платёжные системы ────────
# Только Hamkorbank (UzQR) — см. HAMKOR_* в начале файла

# ──────── Загрузки ────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ──────── Платформа ────────
SUPER_ADMIN_USERNAMES=
DEFAULT_COMMISSION_RATE=15

# ════════════════════════════════════════════════════════════════════
#                 К О М А Н Д А   /   А Л Е Р Т Ы
# ────────────────────────────────────────────────────────────────────
# Перечисли Telegram-никнеймы (без @) через запятую — кому какой алерт.
# Один человек может быть в нескольких ролях. Регистр игнорируется.
#
#   OWNER       — владельцы продукта. Только критические системные
#                 алерты: AI quota / Redis down / DB error / бэкапы.
#   DISPATCHER  — диспетчеры заказов. Висящие заказы без мастера,
#                 мастер не выехал, опоздание по ETA, отмены в транзите.
#   SUPPORT     — техподдержка. Жалобы клиентов и мастеров, споры,
#                 тикеты, эскалации из чата заказов.
#   FINANCE     — финансы. Failed-платежи, возвраты, эскроу > порога,
#                 чарджбэки, расхождения баланса.
#   MODERATOR   — модерация контента. Зафлаганные сообщения чата,
#                 фото-нарушения, форум-репорты.
#
# Пример: ROLE_OWNER_USERNAMES=vlad,dex89666
ROLE_OWNER_USERNAMES=
ROLE_DISPATCHER_USERNAMES=
ROLE_SUPPORT_USERNAMES=
ROLE_FINANCE_USERNAMES=
ROLE_MODERATOR_USERNAMES=
# ════════════════════════════════════════════════════════════════════

MASTER_REGISTRATION_FEE=400000
DEFAULT_REFERRAL_MASTER_BONUS_RATE=5
DEFAULT_REFERRAL_CLIENT_DISCOUNT_RATE=3

# ──────── CORS ────────
CORS_ORIGIN=http://localhost:5173

# ──────── Sentry (backend) ────────
SENTRY_DSN=

# ──────── Хранилище файлов (uploads) ────────
# local — диск контейнера (по умолчанию, теряется при редеплое)
# s3    — Cloudflare R2 / Backblaze B2 / AWS S3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ════════════════════════════════════════════════════════════════════
#                    F R O N T E N D   ( V I T E )
# ════════════════════════════════════════════════════════════════════
VITE_API_URL=/api
VITE_TELEGRAM_BOT_NAME=
VITE_YANDEX_MAPS_KEY=
VITE_YM_COUNTER=
VITE_SENTRY_DSN=

# ─── OpenAI / AI-анализ заказов ──────────────────────────────────────
OPENAI_API_KEY=
# Модель для Vision-анализа фото. gpt-4o — legacy; актуальные варианты:
# gpt-5.4-mini (дешевле), gpt-5.6-luna, gpt-5.4. Выбирать по прогону
# scripts/eval/run-eval.ts, а не «на глаз».
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=45000
# Сколько фото уходит в Vision. Изображения — ~80% входных токенов,
# при этом 3-4 осмысленных кадра точнее 10 случайных.
OPENAI_VISION_MAX_IMAGES=4

# Цены модели за 1M токенов — только для отчёта о стоимости в eval-прогоне.
# Пример для gpt-5.4-mini: EVAL_PRICE_IN=0.75 EVAL_PRICE_OUT=4.50
EVAL_PRICE_IN=
EVAL_PRICE_OUT=

# ─── Прайс-реестр (единый источник цены) ─────────────────────────────
# Пока выключен, смета считается по каталогу в коде — как раньше.
# Порядок включения (каждый шаг проверяется отдельно):
#   1. npx prisma migrate deploy        — таблицы price_*
#   2. npm run pricebook:dry            — посмотреть, что перенесётся
#   3. npm run pricebook:import         — перенести каталоги в реестр
#   4. npm run pricebook:embed          — векторы для подбора работ
#   5. PRICEBOOK_ENABLED=true           — переключить расчёт на реестр
#   6. npm run pricebook:calibrate:dry  — что сделает калибровка
# Включение меняет источник цены для всех новых заказов, поэтому шаг 5
# делается после прогона scripts/eval/run-eval.ts и сверки с прежним путём.
PRICEBOOK_ENABLED=false
# Реестр читается на каждый заказ и меняется редко — держим слепок в памяти.
PRICEBOOK_CACHE_TTL_MS=300000
# Множители срочности, района, этажа и доступа. Применяются только к труду:
# аварийный вызов не делает герметик дороже.
PRICEBOOK_MODIFIERS_ENABLED=true
# Ночное обслуживание реестра: векторы для новых проблем и сбор наблюдений
# из сделок. Калибровка цен по умолчанию — только сухой прогон в логах;
# двигать цены по всему сервису включается отдельно и сознательно.
PRICEBOOK_MAINTENANCE_ENABLED=true
PRICEBOOK_CALIBRATION_ENABLED=false

# ─── Пороги гейта качества AI (scripts/eval/gate.ts) ─────────────────
# Поднимаются по мере роста размеченного набора: на восьми кейсах строгий
# гейт ловит шум, а не регрессии.
EVAL_MIN_CASES=8
EVAL_MIN_CATEGORY_ACC=75
EVAL_MIN_WITHIN20=40
EVAL_MAX_GROSS_MISS=35
EVAL_MIN_REFUSAL_ACC=50
EVAL_MAX_REGRESSION_PP=5

# ─── Резервное копирование базы ─────────────────────────────────────
# Бэкап снимается изнутри бэкенда: pg_dump → gzip → S3 (R2) раз в сутки,
# с догоном после простоя. Прежний путь через GitHub Actions дважды молча
# вставал из-за биллинга. Отметка об успехе — platform_config.last_backup_at,
# её проверяет сторож бэкапов. Ручной запуск: POST /api/admin/backup/run.
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
